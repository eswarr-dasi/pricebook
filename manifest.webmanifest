{
  "name": "Tare - cost per serving, protein per dollar",
  "short_name": "Tare",
  "description": "Scan a barcode and see what it costs at your store, what is in it, and whether it will fill you up.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f8fa",
  "theme_color": "#f7f8fa",
